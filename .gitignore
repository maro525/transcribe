# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Cache / temp (runtime-generated)
model_cache/
tmp_audio/
models/

# Content dirs (keep folders, ignore contents)
input/*
!input/.gitkeep
output/*
!output/.gitkeep
done/*
!done/.gitkeep

# OS
.DS_Store

# Claude Code の TASK_FILE はリポジトリに置かない（~/.local/share/harness/tasks/ へ）
.claude/docs/decisions/*
!.claude/docs/decisions/.gitkeep
.claude/docs/research/*
!.claude/docs/research/.gitkeep
